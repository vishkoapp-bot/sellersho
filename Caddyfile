{
	metrics
	# OBS-01 deploy-fix (2026-11-18): the admin endpoint binds all
	# interfaces INSIDE the edge container (0.0.0.0:2019). Caddy's
	# default (localhost:2019) was unreachable at the container's eth0
	# IP, and Docker publishing forwards exactly there, so the
	# loopback-only host publish (127.0.0.1:2019:2019) could never reach
	# it. Boundary move, accepted: the admin API is a control plane, so
	# it becomes reachable from any container on the platform docker
	# network (platform containers only) AND from the four
	# host-networked collectors (Prometheus, Grafana, node-exporter,
	# nginx-exporter share the host network namespace, so they can reach
	# 127.0.0.1:2019 directly). Sharpest case is Grafana's datasource
	# proxy; the no-secret frontend container is NOT covered by the
	# "compromised backend holds worse" argument — an RCE there now
	# yields full traffic control. The host publish stays 127.0.0.1-only
	# and the endpoint is never proxied. See
	# docs/operations/observability.md (incl. the hardening follow-up,
	# filed not implemented).
	admin 0.0.0.0:2019
    servers {
        timeouts {
            read_header 5s
            read_body 65s
            write 75s
            idle 60s
        }
    }
	email "{$ACME_EMAIL}"
	on_demand_tls {
		ask http://backend:8080/internal/domains/allow
	}
}

(frontend_budget_proxy) {
    @long_image_upload {
        method POST
        path_regexp budget_image ^/api/v1/(upload/product-image|supplier/products/[^/]+/(variants/[^/]+/)?images)$
    }
    handle @long_image_upload {
        reverse_proxy frontend:80 {
            header_up X-Forwarded-Proto {scheme}
            transport http {
                dial_timeout 3s
                response_header_timeout 70s
                keepalive 30s
            }
        }
    }
    handle {
        reverse_proxy frontend:80 {
            header_up X-Forwarded-Proto {scheme}
            transport http {
                dial_timeout 3s
                response_header_timeout 14s
                keepalive 30s
            }
        }
    }
}

:443 {
    tls {
        on_demand
    }
    # Preserve deny/auth/proxy order explicitly; handle groups otherwise sort
    # before a top-level respond directive in the Caddy adapter.
    route {
        @internal path /internal/*
        respond @internal 404
        forward_auth backend:8080 {
            uri /internal/domains/allow?domain={host}
            transport http {
                dial_timeout 2s
                response_header_timeout 4s
            }
        }
        import frontend_budget_proxy
    }
}

:80 {
    route {
        @internal path /internal/*
        respond @internal 404
        @legacy_ip host {$PLATFORM_HTTP_HOST:localhost}
        handle @legacy_ip {
            import frontend_budget_proxy
        }
        handle {
            redir https://{host}{uri} 308
        }
    }
}
