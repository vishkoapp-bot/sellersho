{
	metrics
	auto_https disable_redirects
	default_sni {$PLATFORM_HTTP_HOST:localhost}
	# OBS-01 deploy-fix (2026-11-18): the admin endpoint binds all
	# interfaces INSIDE the edge container (0.0.0.0:2019). Caddy's
	# default (localhost:2019) was unreachable at the container's eth0
	# IP, and Docker publishing forwards exactly there, so the
	# loopback-only host publish (127.0.0.1:2019:2019) could never reach
	# it. Boundary move, accepted: the admin API is a control plane, so
	# it becomes reachable from any container on the platform docker
	# network (platform containers only) AND from the four
	# host-networked collectors (Prometheus, Grafana, node-exporter,
	# nginx-exporter share the host network namespace, so they can reach
	# 127.0.0.1:2019 directly). Sharpest case is Grafana's datasource
	# proxy; the no-secret frontend container is NOT covered by the
	# "compromised backend holds worse" argument — an RCE there now
	# yields full traffic control. The host publish stays 127.0.0.1-only
	# and the endpoint is never proxied. See
	# docs/operations/observability.md (incl. the hardening follow-up,
	# filed not implemented).
	admin 0.0.0.0:2019
    servers {
        timeouts {
            read_header 5s
            read_body 65s
            write 75s
            idle 60s
        }
    }
	email "{$ACME_EMAIL}"
	on_demand_tls {
		ask http://backend:8080/internal/domains/allow
		# EDGE-01 step 5 — D-2 NOTE (owner R-1 Nov 20: NO numeric cap
		# at all — option (a)): there is NO max_certs directive in
		# Caddy v2.
		# `max_certs` was a Caddy v1 tls subdirective; Caddy 2.9.1's
		# adapter rejects it here ("unrecognized parameter
		# 'max_certs'") and rejects `interval`/`burst` too
		# ("no longer supported") — the global on_demand_tls block
		# accepts only `ask` (and `permission`). Shipping the line
		# would break the deploy: deploy_remote.py runs `caddy
		# validate` before including ssl.yml. The effective guards
		# as shipped are: (a) the ask endpoint itself — unknown /
		# revoked / malformed domains are denied BEFORE any ACME
		# order, so a scanner cannot trigger issuance (the step-3
		# deny-cache bounds the ask's DB cost); (b) the CA's own rate
		# limits as backstop (LE 300 orders/3h; ZeroSSL's own, since
		# ACME_EMAIL stays UNSET in prod — verified empty, ZeroSSL
		# fallback issuance). Owner R-1 (Nov 20): NO numeric cap —
		# unlimited stores/domains as the platform grows. Accepted
		# residual risk: issuance is bounded only by the admin
		# approval process (each domain needs a store + admin
		# approval). Do not re-add max_certs.
	}
}

(frontend_budget_proxy) {
    @long_image_upload {
        method POST
        path_regexp budget_image ^/api/v1/(upload/product-image|supplier/products/[^/]+/(variants/[^/]+/)?images)$
    }
    handle @long_image_upload {
        reverse_proxy frontend:80 {
            header_up X-Forwarded-Proto {scheme}
            transport http {
                dial_timeout 3s
                response_header_timeout 70s
                keepalive 30s
            }
        }
    }
    handle {
        reverse_proxy frontend:80 {
            header_up X-Forwarded-Proto {scheme}
            transport http {
                dial_timeout 3s
                response_header_timeout 14s
                keepalive 30s
            }
        }
    }
}

(frontend_tls_routes) {
    # EDGE-01 step 5 (audit §5.4/§7): edge access log. The Caddyfile
    # had no `log` directive, so the edge emitted no access log at
    # all. Default format (JSON) to stdout, i.e. the container log —
    # the same sink the backend's stdout already uses. NOT `debug`:
    # debug logging cost ~13 ms p50 at 100 RPS in the audit's runs;
    # the INFO access log's cost is measured in the step-7 load
    # report. Do NOT add `encode`: nginx already compresses
    # everything worth compressing (audit §4.3.4).
    log
    # Preserve deny/auth/proxy order explicitly; handle groups otherwise sort
    # before a top-level respond directive in the Caddy adapter.
    route {
        @internal path /internal/*
        respond @internal 404
        forward_auth backend:8080 {
            uri /internal/domains/allow?domain={host}
            transport http {
                dial_timeout 2s
                response_header_timeout 4s
            }
        }
        import frontend_budget_proxy
    }
}

:443 {
    tls {
        on_demand
    }
    import frontend_tls_routes
}

https://{$PLATFORM_HTTP_HOST:localhost} {
    tls {
        issuer acme {
            profile shortlived
            disable_tlsalpn_challenge
        }
    }
    import frontend_tls_routes
}

:80 {
    route {
        @internal path /internal/*
        respond @internal 404
        @primary_https_only {
            host {$PLATFORM_HTTP_HOST:localhost}
            expression `"{$PLATFORM_PRIMARY_HTTPS_ONLY:false}" == "true"`
        }
        redir @primary_https_only https://{$PLATFORM_HTTP_HOST:localhost}{uri} 308
        @legacy_ip host {$PLATFORM_HTTP_HOST:localhost}
        handle @legacy_ip {
            import frontend_budget_proxy
        }
        handle {
            redir https://{host}{uri} 308
        }
    }
}
